{
  "layer": "top",
  "position": "top",
  "spacing": 8,
  "modules-left": [
    "wlr/taskbar"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "clock"
  ],
  "wlr/taskbar": {
    "all-outputs": false,
    "format": "{icon}",
    "icon-size": 16,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{app_id}\n{title}",
    "max-length": 0
  },
  "hyprland/workspaces": {
    "all-outputs": false,
    "sort-by-number": true,
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace r+1",
    "on-scroll-down": "hyprctl dispatch workspace r-1"
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%H:%M:%S}"
  }
}