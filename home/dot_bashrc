# ------------------------------------------------------------
# Interactive Shell
# ------------------------------------------------------------

# Stop processing if the shell is not interactive.
case $- in
    *i*) ;;
    *) return ;;
esac


# ------------------------------------------------------------
# History
# ------------------------------------------------------------

# Ignore duplicate commands and commands starting with spaces.
HISTCONTROL=ignoreboth

# Append commands instead of overwriting the history file.
shopt -s histappend

# Keep a larger command history.
HISTSIZE=10000
HISTFILESIZE=20000


# ------------------------------------------------------------
# Shell Behavior
# ------------------------------------------------------------

# Update terminal dimensions after each command.
shopt -s checkwinsize


# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

# Use GNU Nano as the default text editor.
export EDITOR=nano
export VISUAL=nano

# Add user-installed executables to PATH if not already present.
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi


# ------------------------------------------------------------
# Colors
# ------------------------------------------------------------

# Enable colored output for supported commands.
if command -v dircolors >/dev/null 2>&1; then
    if [[ -r "$HOME/.dircolors" ]]; then
        eval "$(dircolors -b "$HOME/.dircolors")"
    else
        eval "$(dircolors -b)"
    fi

    alias ls='ls --color=auto'
fi


# ------------------------------------------------------------
# Aliases
# ------------------------------------------------------------

# Load personal aliases if available.
if [[ -f "$HOME/.bash_aliases" ]]; then
    source "$HOME/.bash_aliases"
fi


# ------------------------------------------------------------
# Bash Completion
# ------------------------------------------------------------

# Enable programmable completion outside POSIX mode.
if ! shopt -oq posix; then
    if [[ -f /usr/share/bash-completion/bash_completion ]]; then
        source /usr/share/bash-completion/bash_completion
    elif [[ -f /etc/bash_completion ]]; then
        source /etc/bash_completion
    fi
fi


# ------------------------------------------------------------
# Node Version Manager
# ------------------------------------------------------------

# Load NVM and its Bash completion when installed.
export NVM_DIR="$HOME/.nvm"

if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
fi

if [[ -s "$NVM_DIR/bash_completion" ]]; then
    source "$NVM_DIR/bash_completion"
fi


# ------------------------------------------------------------
# Starship Prompt
# ------------------------------------------------------------

# Initialize Starship when available.
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi
