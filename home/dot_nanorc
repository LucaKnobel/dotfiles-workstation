
## ============================================================
## GNU Nano Configuration
## Debian 13 / Kitty / GitHub Dark High Contrast
## Minimal interface with subtle colors and clear typography
## ============================================================


## ------------------------------------------------------------
## Editor Behavior
## ------------------------------------------------------------

# Display line numbers in the left margin.
set linenumbers

# Automatically indent new lines.
set autoindent

# Use four spaces for indentation.
set tabsize 4
set tabstospaces

# Enable mouse support.
set mouse

# Show a subtle scroll indicator.
set indicator

# Visually wrap long lines without modifying their content.
set softwrap

# Allow multiple open file buffers.
set multibuffer

# Remember search history and cursor positions.
set historylog
set positionlog

# Enable bracket matching.
set matchbrackets "(<[{)>]}"

# Use smart Home key behavior.
set smarthome


## ------------------------------------------------------------
## Minimal User Interface
## ------------------------------------------------------------

# Use a compact status bar instead of a full title bar.
set minibar

# Show keyboard shortcut hints at the bottom.
unset nohelp

# Clear temporary messages quickly.
set quickblank


## ------------------------------------------------------------
## Colors
## ------------------------------------------------------------

# Preserve Kitty's default background throughout the UI.
# Nano supports three-digit hexadecimal color values only.

# Subtle gray line numbers on the normal terminal background.
set numbercolor #888,normal

# Subtle scroll indicator.
set scrollercolor #888,normal

# Neutral minibar with no colored background.
set minicolor #bbb,normal

# Neutral title bar fallback.
set titlecolor #bbb,normal

# Readable prompts without background highlighting.
set promptcolor #aaf,normal

# Discreet status messages.
set statuscolor #bbb,normal

# Red error text without a solid red background.
set errorcolor bold,#f88,normal

# Keyboard shortcut colors.
set keycolor #aaf,normal

# Shortcut description colors.
set functioncolor #9d9,normal

# Selection remains clearly distinguishable.
set selectedcolor #000,#8bf

# Highlight search matches without harsh colors.
set spotlightcolor #000,#dd9


## ------------------------------------------------------------
## Search
## ------------------------------------------------------------

# Search case-insensitively by default.
unset casesensitive


